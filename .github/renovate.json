{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "timezone": "Europe/Berlin",
  "schedule": [
    "before 6am on monday"
  ],
  "labels": [
    "dependencies"
  ],
  "branchPrefix": "feature/",
  "baseBranchPatterns": [
    "$default"
  ],
  "commitMessagePrefix": "chore(deps):",
  "dependencyDashboard": {
    "enabled": true
  },
  "packageRules": [
    {
      "description": "Update workflow actions together",
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "github actions"
    },
    {
      "description": "The engine scripts run on one tested Python; raise it deliberately, not by pull request",
      "matchManagers": [
        "github-actions"
      ],
      "matchDepNames": [
        "python"
      ],
      "enabled": false
    },
    {
      "description": "Runner images are chosen on purpose (a new Ubuntu changes Python and tool versions); raise them by hand",
      "matchManagers": [
        "github-actions"
      ],
      "matchDepNames": [
        "ubuntu"
      ],
      "enabled": false
    },
    {
      "description": "requirements in manifest.json are what users install: changing one is a release decision, not a dependency bump",
      "matchManagers": [
        "homeassistant-manifest"
      ],
      "enabled": false
    },
    {
      "description": "Follow stable Home Assistant base tags, including new Alpine versions",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "ghcr.io/seb5594/home-assistant-base"
      ],
      "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)-(?<patch>\\d{4})\\.(?<build>\\d{1,2})\\.(?<revision>\\d+)$",
      "pinDigests": false
    },
    {
      "description": "Base image and the Alpine packages built for it must move together",
      "matchPackageNames": [
        "ghcr.io/seb5594/home-assistant-base",
        "alpine",
        "/^alpine_/"
      ],
      "groupName": "alpine base and packages"
    },
    {
      "description": "Alpine package versions such as 2.54.0-r0 are not semver",
      "matchDatasources": [
        "repology"
      ],
      "versioning": "loose"
    },
    {
      "description": "Follow stable Home Assistant base tags, including new Alpine versions",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "ghcr.io/seb5594/home-assistant-base-python"
      ],
      "versioning": "regex:^(?<compatibility>\\d+\\.\\d+)-alpine(?<major>\\d+)\\.(?<minor>\\d+)-(?<patch>\\d{4})\\.(?<build>\\d{1,2})\\.(?<revision>\\d+)$",
      "pinDigests": false
    },
    {
      "description": "Update this base through the shared regex manager for Dockerfiles and project metadata",
      "matchManagers": [
        "dockerfile"
      ],
      "matchPackageNames": [
        "ghcr.io/seb5594/home-assistant-base",
        "ghcr.io/seb5594/home-assistant-base-python"
      ],
      "enabled": false
    }
  ],
  "customManagers": [
    {
      "description": "Versions marked with '# renovate: datasource=... depName=...' in a Dockerfile",
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)Dockerfile$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+(?:ENV |ARG )?[A-Za-z0-9_-]+=(?<currentValue>[^\\s\\\\]+)"
      ]
    },
    {
      "description": "Track the same base tag in app Dockerfiles and generator metadata",
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)Dockerfile$/",
        "/(^|/)project\\.json$/"
      ],
      "datasourceTemplate": "docker",
      "matchStrings": [
        "(?:ARG BUILD_FROM=|FROM |\"base_image\"\\s*:\\s*\")(?<depName>ghcr\\.io/seb5594/home-assistant-base(?:-python)?):(?<currentValue>[0-9][0-9a-z.\\-]+)(?:[\"\\s]|$)"
      ]
    }
  ]
}
